{
  "framework": null,
  "installCommand": "npm ci --prefix web-client",
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "web-client/dist",
  "rewrites": [
    {
      "source": "/api/mp/card_tokens",
      "destination": "https://api.mercadopago.com/v1/card_tokens"
    },
    {
      "source": "/api/create-subscription",
      "destination": "https://rgrhalzcbhhydizlgztn.supabase.co/functions/v1/create-subscription"
    },
    { "source": "/admin", "destination": "/painel/index.html" },
    { "source": "/sucesso-assinatura", "destination": "/painel/index.html" },
    { "source": "/:slug/login", "destination": "/painel/index.html" },
    { "source": "/:slug/admin", "destination": "/painel/index.html" },
    { "source": "/:slug/admin/:path*", "destination": "/painel/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
